---
// Shown for any address on the site that doesn't exist. Links use the full site path,
// because this page can be served from any URL (for example /Portfolio/some/old/link).
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
---

<Base
  title="Page not found | Ahmed Ali"
  description="This page isn't part of the edition. Head back to Ahmed Ali's portfolio front page."
  noindex
>
  <main id="main" class="not-found page" tabindex="-1">
    <div class="edition-line label">
      <span>Correction</span>
      <span class="edition-name">The personal edition</span>
      <span>Error 404</span>
    </div>
    <h1 class="not-found-title">Stop the presses.</h1>
    <p class="not-found-note">
      This page didn’t make it into the edition. It may have moved, or the link has a typo.
    </p>
    <div class="actions">
      <a class="text-link" href={base}>Back to the front page <span aria-hidden="true">↑</span></a>
      <a class="text-link" href={`${base}#games`}>Read the stories <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={`${base}#contact`}>Write a letter <span aria-hidden="true">↗</span></a>
    </div>
  </main>
</Base>
